{
  "cleanUrls": false,
  "headers": [
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/manifest.webmanifest", "headers": [ { "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/pdfjs/(.*)", "headers": [ { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/(.*)\\.(png|webp|woff2)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] }
  ]
}
